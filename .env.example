# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# --- Sanity (project id and dataset are public by design) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-04

# Sanity -> API -> Tokens, "Viewer" role. Server-only.
SANITY_API_READ_TOKEN=

# Shared secret for the Sanity webhook that triggers revalidation.
# The same value goes in the webhook config in sanity.io/manage.
SANITY_REVALIDATE_SECRET=

# --- Resend (contact form delivery) ---
RESEND_API_KEY=
CONTACT_FROM_EMAIL=website@workout247fitness.com
# Fallback recipient if a Location has no contact email set in Sanity.
CONTACT_FALLBACK_EMAIL=

# --- Rate limiting (Upstash, injected automatically by the Vercel integration) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Site ---
# Production domain; set to the preview URL in Vercel's Preview environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
